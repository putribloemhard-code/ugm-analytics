MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ugm_app
MYSQL_PASSWORD=isi_password_di_sini
MYSQL_DB=ugm_analytics
MYSQL_ROOT_PASSWORD=isi_password_root_di_sini

# Opsional -- Ringkasan AI & tombol "Generate insight" di halaman Dampak
# (api/app/services/insight_ai.py) serta ekstraksi AI dokumen akreditasi.
# Kalau dikosongkan, halaman tetap jalan pakai narasi template pandas
# (lihat berita-dampak/scripts/narasi_logic.py).
OPENAI_API_KEY=isi_openai_api_key_di_sini
# Opsional -- isi kalau OPENAI_API_KEY diakses lewat gateway/proxy
# OpenAI-compatible (bukan api.openai.com langsung). Kosongkan untuk pakai
# endpoint default OpenAI.
OPENAI_BASE_URL=
