# Contoh environment untuk API FastAPI (dibaca di api/app/config.py).
# Salin ke .env di host target -- JANGAN commit nilai asli.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ugm_app
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=ugm_analytics
API_CORS_ORIGINS=http://localhost:3000
ACCREDITATION_UPLOAD_DIR=/app/data/accreditation/uploads
ACCREDITATION_GENERATED_DIR=/app/data/accreditation/generated
# Ekstraksi AI dokumen akreditasi (opsional; kosong = fitur ekstraksi nonaktif)
OPENAI_API_KEY=
OPENAI_BASE_URL=
