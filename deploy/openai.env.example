# Salin ke deploy/openai.env (chmod 600) untuk MENGAKTIFKAN ekstraksi AI dokumen akreditasi.
# Opsional: tanpa file ini API tetap jalan dan tombol "Ekstrak data" di /akreditasi nonaktif.
# JANGAN commit deploy/openai.env (sudah di .gitignore).
OPENAI_API_KEY=replace_me
# Kosongkan untuk api.openai.com; isi kalau memakai gateway kompatibel OpenAI.
OPENAI_BASE_URL=
