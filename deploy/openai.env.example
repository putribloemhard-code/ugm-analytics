# Salin ke deploy/openai.env (chmod 600) untuk MENGAKTIFKAN fitur AI: ekstraksi dokumen akreditasi,
# Ringkasan AI, dan tombol "Generate insight" di halaman Dampak.
# Opsional: tanpa file ini API tetap jalan; fitur AI nonaktif dan ringkasan memakai narasi template.
# JANGAN commit deploy/openai.env (sudah di .gitignore).
OPENAI_API_KEY=replace_me
# Kosongkan untuk api.openai.com; isi kalau memakai gateway kompatibel OpenAI.
OPENAI_BASE_URL=
