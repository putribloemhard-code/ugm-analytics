# Salin ke deploy/google.env (chmod 600) untuk MENGAKTIFKAN tombol "Masuk dengan Google".
# Opsional: tanpa file ini tombol Google tidak tampil dan login email + password tetap berjalan.
# JANGAN commit deploy/google.env (sudah di .gitignore).
# Nilai dari Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
# Alamat callback yang DIDAFTARKAN di "Authorized redirect URIs" client tersebut, harus sama persis.
# Kosongkan untuk memakai APP_BASE_URL + /api/v1/analytics/auth/google/callback.
GOOGLE_REDIRECT_URI=https://dts-lab.web.id/api/v1/analytics/auth/google/callback
# Alamat web yang dibuka pengguna (tujuan kembali setelah login), tanpa garis miring di akhir.
APP_BASE_URL=https://dts-lab.web.id
