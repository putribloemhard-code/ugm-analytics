# Salin ke deploy/smtp.env (chmod 600) untuk MENGAKTIFKAN email "Lupa password" (tautan reset).
# Opsional: tanpa file ini API tetap jalan; tautan reset hanya bisa dibuat admin dari halaman Admin.
# JANGAN commit deploy/smtp.env (sudah di .gitignore).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465), atau none
SMTP_SECURITY=starttls
SMTP_USER=akun-pengirim@ugm.ac.id
SMTP_PASSWORD=replace_me
SMTP_FROM=UGM Analytics <akun-pengirim@ugm.ac.id>
# Alamat web yang dibuka pengguna (dipakai di tautan email), tanpa garis miring di akhir.
APP_BASE_URL=https://analytics.example.ugm.ac.id
