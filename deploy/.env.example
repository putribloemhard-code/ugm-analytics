# Deployment identity and public endpoint.
# Set PUBLIC_ORIGIN to the exact external browser origin, without a trailing slash.
COMPOSE_PROJECT_NAME=ugm-analytics
UGM_ANALYTICS_BIND_ADDRESS=127.0.0.1
UGM_ANALYTICS_PORT=8092
PUBLIC_ORIGIN=http://replace-with-approved-host-or-domain:8092

# Browser build settings for an isolated subpath deployment.
VITE_APP_BASE_PATH=/analytics/
VITE_API_BASE_URL=/analytics/api/v1

# PostgreSQL initialization and runtime connection.
# Generate a unique non-placeholder password on the BTD host before first startup.
POSTGRES_DB=ugm_analytics
POSTGRES_USER=ugm_app
POSTGRES_PASSWORD=replace_before_first_start

# Source MySQL reader (for initial data migration if using mysql-reader container).
SOURCE_MYSQL_DB=ugm_analytics
SOURCE_MYSQL_USER=ugm_reader
SOURCE_MYSQL_PASSWORD=replace_mysql_reader_password
SOURCE_MYSQL_ROOT_PASSWORD=replace_mysql_root_password

