# Environment & artefak lokal — JANGAN di-commit

# Kredensial (MySQL, dll.) — JANGAN di-commit
.env
# Secret Google OAuth (disiapkan utk Fase B login Google)
client_secret*.json

# Python venv (besar, bisa dibuat ulang)
venv/
.venv/

# Bytecode
__pycache__/
*.pyc

# Log update & temp
berita-dampak/logs_*.txt
docs/_ocr_tmp/

# File sementara
tailscale_login.txt

# File upload user (fitur upload pendukung akreditasi) -- binary, tidak perlu di-commit
akreditasi/data/uploads/
# Laporan Word hasil tombol Generate (riwayat per user)
akreditasi/data/generated/

# OS
.DS_Store
Thumbs.db
Desktop.ini
push_log.txt
push_log*.txt

# Graphify generated cache/backups
/graphify-out/cache/
/graphify-out/20*/

# Dump database - jangan commit
ugm_analytics_dump.sql

# Standalone frontend build artifacts
web/node_modules/
web/dist/

# Isolated BTD deployment runtime state and target environment
/deploy/.env
/deploy/data/
/deploy/stage-manifest.sha256
/deploy/remote-manifest.sha256

# Local test/cache artifacts for the standalone API
api/.pytest_cache/
api/**/__pycache__/

# Graphify output (snapshot graph, jangan di-track)
graphify-out/
